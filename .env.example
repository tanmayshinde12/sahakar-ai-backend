# Required for text chat and document questions
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Local server settings. Port 8787 avoids services already running on 8000/8001.
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Required only for live phone calls. Point this to a Google Cloud service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
EXOTEL_STREAM_TOKEN=
